---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Devotionals | Walk Together">
  <p class="eyebrow">New Testament study</p>
  <h1>Weekly devotionals</h1>
  <div id="list" style="display:flex; flex-direction:column; gap:1rem; margin-top:1.5rem;"></div>

  <script type="module">
    import { supabase } from '../../lib/supabase.js';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) window.location.href = '/login';

    const { data } = await supabase.from('devotionals').select('*').order('week_start', { ascending: false });
    const list = document.getElementById('list');
    (data || []).forEach(d => {
      const a = document.createElement('a');
      a.href = `/devotionals/${d.id}`;
      a.className = 'card';
      a.style.cssText = 'text-decoration:none; color:inherit;';
      a.innerHTML = `
        <div class="eyebrow">${d.week_start} \u2022 ${d.passage_ref}</div>
        <h2 style="font-size:1.2rem;">${d.title}</h2>
      `;
      list.appendChild(a);
    });
    if (!data || data.length === 0) {
      list.innerHTML = '<p style="color:var(--ink-soft);">No devotionals added yet. Add rows to the devotionals table in Supabase to get started.</p>';
    }
  </script>
</Layout>
