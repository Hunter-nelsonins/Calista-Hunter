---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Choose a new password | Walk Together">
  <p class="eyebrow">Password reset</p>
  <h1>Choose a new password</h1>
  <p id="expired" class="card" style="display:none; max-width:420px;">This reset link has expired or was already used. <a href="/login">Go to sign in</a> and choose "Forgot password?" for a fresh link.</p>
  <form id="reset-form" class="card" style="max-width:420px; display:none; flex-direction:column; gap:0.9rem; margin-top:1.5rem;">
    <input type="password" id="new-password" placeholder="New password (at least 8 characters)" autocomplete="new-password" required minlength="8" />
    <input type="password" id="confirm-password" placeholder="Type it again" autocomplete="new-password" required />
    <button type="submit">Save new password</button>
    <p id="msg" class="inline-msg" role="status"></p>
  </form>

  <script type="module">
    import { supabase } from '../lib/supabase.js';

    // supabase-js picks the recovery session out of the link automatically.
    let { data: { session } } = await supabase.auth.getSession();
    if (!session) { await new Promise(r => setTimeout(r, 1200)); ({ data: { session } } = await supabase.auth.getSession()); }
    if (!session) {
      document.getElementById('expired').style.display = 'block';
    } else {
      document.getElementById('reset-form').style.display = 'flex';
      document.getElementById('reset-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = document.getElementById('msg');
        const a = document.getElementById('new-password').value, b = document.getElementById('confirm-password').value;
        if (a !== b) { msg.className = 'inline-msg error'; msg.textContent = 'The two passwords do not match.'; return; }
        const { error } = await supabase.auth.updateUser({ password: a });
        if (error) { msg.className = 'inline-msg error'; msg.textContent = error.message; return; }
        msg.className = 'inline-msg ok'; msg.textContent = 'Your password has been changed. Taking you home…';
        setTimeout(() => { window.location.href = '/'; }, 1200);
      });
    }
  </script>
</Layout>
