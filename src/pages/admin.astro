---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Admin | Walk Together">
  <div id="app" style="display:none;">
    <p class="eyebrow">Admin</p>
    <h1>Manage devotionals</h1>
    <p class="home-subtitle">Add, edit, and remove weekly devotionals and their daily entries.</p>

    <section class="home-section" style="margin-top:2rem;">
      <div class="admin-section-head">
        <h2 style="font-size:1.15rem; margin:0;">Profile pictures</h2>
      </div>
      <div id="avatars-list" style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;"></div>
    </section>

    <section class="home-section" id="accounts-section" style="display:none;">
      <div class="admin-section-head">
        <h2 style="font-size:1.15rem; margin:0;">Accounts</h2>
      </div>
      <p class="card-meta" style="margin:0.5rem 0 0;">Only you, the administrator, can see this. Every change goes through a protected server function that checks who you are each time. Passwords are never shown or stored here.</p>
      <div id="accounts-list" style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;"></div>

      <div class="card form-panel" id="account-edit-panel" style="display:none; margin-top:1rem;">
        <h3 id="account-edit-title" style="margin:0;">Edit user</h3>
        <input type="hidden" id="acct-edit-id" />
        <div class="form-row"><label for="acct-name">Display name</label><input type="text" id="acct-name" maxlength="50" /></div>
        <div class="form-row"><label for="acct-username">Username (lowercase letters, numbers, . _ -)</label><input type="text" id="acct-username" maxlength="30" /></div>
        <div class="form-row"><label for="acct-email">Email address</label><input type="email" id="acct-email" /></div>
        <div class="form-row" id="acct-email-confirm-row" style="display:none;"><label for="acct-email2">Type the new email address again</label><input type="email" id="acct-email2" /></div>
        <div class="form-row" id="acct-pw-row" style="display:none;"><label for="acct-pw">Your own password (needed to change an email)</label><input type="password" id="acct-pw" autocomplete="current-password" /></div>
        <p class="card-meta" id="acct-email-warning" style="display:none; margin:0;">Changing an email takes effect immediately and cannot be confirmed by the new inbox first. Double-check the spelling. If they can sign in, it is safer for them to change their own email in Account settings.</p>
        <div class="form-actions"><button type="button" id="acct-save-btn">Save changes</button><button type="button" id="acct-cancel-btn" class="btn-secondary">Cancel</button></div>
        <p id="acct-edit-msg" class="inline-msg" role="status"></p>
      </div>

      <div class="card form-panel" id="account-reset-panel" style="display:none; margin-top:1rem;">
        <h3 id="account-reset-title" style="margin:0;">Reset password</h3>
        <input type="hidden" id="acct-reset-id" />
        <p class="card-meta" style="margin:0;">This creates a one-time temporary password. It is shown to you once, is never saved or emailed, and they must choose their own new password the moment they sign in.</p>
        <div class="form-row"><label for="acct-reset-pw">Your own password (to confirm it's you)</label><input type="password" id="acct-reset-pw" autocomplete="current-password" /></div>
        <div class="form-row"><label for="acct-reset-temp">Choose the temporary password yourself (optional; leave blank to generate one)</label><input type="text" id="acct-reset-temp" autocomplete="off" /></div>
        <div class="form-actions"><button type="button" id="acct-reset-btn">Set temporary password</button><button type="button" id="acct-reset-close" class="btn-secondary">Close</button></div>
        <p id="acct-reset-msg" class="inline-msg" role="status"></p>
        <div id="acct-reset-result" style="display:none;">
          <p class="eyebrow" style="margin:0;">Temporary password &mdash; shown once</p>
          <div id="acct-temp-value" class="temp-password"></div>
          <p class="card-meta" style="margin:0;">Give it to them in person or by phone, not by email or text. Once you close this, it can't be shown again.</p>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="admin-section-head">
        <h2 style="font-size:1.15rem; margin:0;">Devotional weeks</h2>
        <button type="button" id="new-week-btn" class="btn-small">+ Add week</button>
      </div>

      <div class="card form-panel" id="week-form-panel" style="display:none; margin:1.25rem 0;">
        <input type="hidden" id="week-id" />
        <div class="form-row">
          <label for="week-title">Devotional week title</label>
          <input type="text" id="week-title" placeholder="e.g. Walking in Grace" />
        </div>
        <div class="form-row">
          <label for="week-passage">Passage reference</label>
          <input type="text" id="week-passage" placeholder="e.g. Ephesians 2:1-10" />
        </div>
        <div class="form-row">
          <label for="week-theme">Theme</label>
          <input type="text" id="week-theme" placeholder="Short theme (optional)" />
        </div>
        <div class="form-row">
          <label for="week-start">Week start date</label>
          <input type="date" id="week-start" />
        </div>
        <div class="form-row">
          <label for="week-prompt">Weekly discussion prompt</label>
          <textarea id="week-prompt" rows="3" placeholder="Optional prompt for your weekly discussion"></textarea>
        </div>
        <div class="form-actions">
          <button type="button" id="save-week-btn">Save week</button>
          <button type="button" id="cancel-week-btn" class="btn-secondary">Cancel</button>
        </div>
      </div>

      <div id="weeks-list" style="display:flex; flex-direction:column; gap:0.75rem; margin-top:1rem;"></div>
    </section>

    <section class="home-section">
      <div class="admin-section-head">
        <h2 style="font-size:1.15rem; margin:0;">Daily entries</h2>
      </div>

      <div class="form-row" style="max-width:420px; margin:1.25rem 0 1rem;">
        <label for="day-week-select">Select a devotional week</label>
        <select id="day-week-select"></select>
      </div>

      <button type="button" id="new-day-btn" class="btn-small" style="margin-bottom:1.25rem;">+ Add day</button>

      <div class="card form-panel" id="day-form-panel" style="display:none; margin-bottom:1.25rem;">
        <input type="hidden" id="day-id" />
        <div class="form-row">
          <label for="day-number">Day number</label>
          <input type="number" id="day-number" min="1" step="1" />
        </div>
        <div class="form-row">
          <label for="day-title">Daily title</label>
          <input type="text" id="day-title" />
        </div>
        <div class="form-row">
          <label for="day-scripture">Scripture passage</label>
          <input type="text" id="day-scripture" placeholder="e.g. Luke 24:13-16" />
        </div>
        <div class="form-row">
          <label for="day-explanation">Simple explanation</label>
          <textarea id="day-explanation" rows="3"></textarea>
        </div>
        <div class="form-row">
          <label for="day-application">Daily application</label>
          <textarea id="day-application" rows="3"></textarea>
        </div>
        <div class="form-row">
          <label for="day-question">Daily question</label>
          <textarea id="day-question" rows="2" placeholder="Optional"></textarea>
        </div>
        <div id="day-new-fields" style="display:none; flex-direction:column; gap:1rem;">
          <p class="eyebrow" style="margin:0.5rem 0 0;">Optional extras (shown in addition to the sections above, never instead of them)</p>
          <div class="form-row" id="day-main-row" style="display:none;">
            <label for="day-main">Today's reading (the longer main passage, e.g. James 1:19-27)</label>
            <input type="text" id="day-main" placeholder="e.g. James 1:19-27" />
          </div>
          <div class="form-row">
            <label for="day-support">Supporting Scripture</label>
            <input type="text" id="day-support" placeholder="e.g. Proverbs 18:13" />
          </div>
          <div class="form-row">
            <label for="day-understanding">Understanding the Bible (blank line = new paragraph)</label>
            <textarea id="day-understanding" rows="8"></textarea>
          </div>
          <div class="form-row">
            <label for="day-expanded">What this means for us (blank line = new paragraph)</label>
            <textarea id="day-expanded" rows="8"></textarea>
          </div>
          <div class="form-row" id="day-lookback-row" style="display:none;">
            <label for="day-lookback">Looking back together (evening reflection; start a line with "- " for a list)</label>
            <textarea id="day-lookback" rows="6"></textarea>
          </div>
          <div class="form-row" id="day-prompts-row" style="display:none;">
            <label for="day-prompts">Take it to prayer (optional personal prompts; start a line with "- " for each)</label>
            <textarea id="day-prompts" rows="4"></textarea>
          </div>
        </div>
        <div class="form-actions">
          <button type="button" id="save-day-btn">Save day</button>
          <button type="button" id="cancel-day-btn" class="btn-secondary">Cancel</button>
        </div>
      </div>

      <div id="days-list" style="display:flex; flex-direction:column; gap:0.75rem;"></div>
    </section>
  </div>

  <script type="module">
    import { supabase } from '../lib/supabase.js';
    import { buildProfileMap, avatarHtml, setAvatar } from '../lib/avatars.js';
    import { parseScriptureRef } from '../lib/bible.js';
    import { getMyAccount, invokeAdmin } from '../lib/account.js';

    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = '/login';
    } else {
      document.getElementById('app').style.display = 'block';

      function esc(s) {
        const div = document.createElement('div');
        div.textContent = s ?? '';
        return div.innerHTML;
      }

      // ---------------- Profile pictures ----------------
      const avatarsList = document.getElementById('avatars-list');

      function avatarRow(profile) {
        const div = document.createElement('div');
        div.className = 'card admin-row';
        const inputId = `avatar-input-${profile.id}`;
        div.innerHTML = `
          <div class="person-row">
            <span id="avatar-preview-${profile.id}">${avatarHtml(profile, 48)}</span>
            <div style="font-weight:700;">${esc(profile.display_name)}</div>
          </div>
          <div class="admin-row-actions">
            <input type="file" id="${inputId}" accept="image/*" style="display:none;" />
            <button type="button" class="btn-small btn-secondary" data-action="choose">Change photo</button>
          </div>
        `;
        const fileInput = div.querySelector(`#${inputId}`);
        div.querySelector('[data-action="choose"]').addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', async () => {
          const file = fileInput.files?.[0];
          if (!file) return;
          try {
            await setAvatar(profile.id, file);
            await loadAvatars();
          } catch (err) {
            alert(`Could not upload photo: ${err.message}`);
          }
        });
        return div;
      }

      async function loadAvatars() {
        const { data } = await supabase.from('profiles').select('id, display_name, avatar_url').order('display_name');
        const profileMap = await buildProfileMap(data);
        avatarsList.innerHTML = '';
        (data || []).forEach(p => avatarsList.appendChild(avatarRow(profileMap[p.id] ? { ...profileMap[p.id], id: p.id } : p)));
      }

      // The optional new day fields exist only once the additive database update has been applied.
      let hasNewDayFields = false;
      let hasEveningFields = false;
      {
        const probe = await supabase.from('devotional_days').select('understanding_text').limit(1);
        hasNewDayFields = !probe.error;
        document.getElementById('day-new-fields').style.display = hasNewDayFields ? 'flex' : 'none';
        const probe2 = await supabase.from('devotional_days').select('prayer_prompts').limit(1);
        hasEveningFields = !probe2.error;
        ['day-main-row', 'day-lookback-row', 'day-prompts-row'].forEach(i => { document.getElementById(i).style.display = hasEveningFields ? 'flex' : 'none'; });
      }

      let weeks = [];
      let currentDays = [];
      let selectedWeekId = null;

      // ---------------- Weeks ----------------
      const weekFormPanel = document.getElementById('week-form-panel');
      const weeksList = document.getElementById('weeks-list');

      function openWeekForm(week) {
        document.getElementById('week-id').value = week?.id || '';
        document.getElementById('week-title').value = week?.title || '';
        document.getElementById('week-passage').value = week?.passage_ref || '';
        document.getElementById('week-theme').value = week?.theme || '';
        document.getElementById('week-start').value = week?.week_start || '';
        document.getElementById('week-prompt').value = week?.discussion_prompt || '';
        weekFormPanel.style.display = 'flex';
        weekFormPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function closeWeekForm() {
        weekFormPanel.style.display = 'none';
      }

      document.getElementById('new-week-btn').addEventListener('click', () => openWeekForm(null));
      document.getElementById('cancel-week-btn').addEventListener('click', closeWeekForm);

      document.getElementById('save-week-btn').addEventListener('click', async () => {
        const id = document.getElementById('week-id').value;
        const payload = {
          title: document.getElementById('week-title').value.trim(),
          passage_ref: document.getElementById('week-passage').value.trim(),
          theme: document.getElementById('week-theme').value.trim() || null,
          week_start: document.getElementById('week-start').value,
          discussion_prompt: document.getElementById('week-prompt').value.trim() || null,
        };
        if (!payload.title || !payload.passage_ref || !payload.week_start) {
          alert('Title, passage reference, and week start date are required.');
          return;
        }
        if (id) {
          await supabase.from('devotionals').update(payload).eq('id', id);
        } else {
          await supabase.from('devotionals').insert(payload);
        }
        closeWeekForm();
        await loadWeeks();
      });

      function weekRow(w) {
        const div = document.createElement('div');
        div.className = 'card admin-row';
        div.innerHTML = `
          <div>
            <div class="eyebrow">${esc(w.week_start)} &bull; ${esc(w.passage_ref)}</div>
            <h3 style="margin:0.25rem 0; font-size:1.05rem;">${esc(w.title)}</h3>
            ${w.theme ? `<p class="card-meta" style="margin:0;">${esc(w.theme)}</p>` : ''}
          </div>
          <div class="admin-row-actions">
            <button type="button" class="btn-small btn-secondary" data-action="edit">Edit</button>
            <button type="button" class="btn-small btn-danger" data-action="delete">Delete</button>
          </div>
        `;
        div.querySelector('[data-action="edit"]').addEventListener('click', () => openWeekForm(w));
        div.querySelector('[data-action="delete"]').addEventListener('click', async () => {
          if (!confirm(`Delete "${w.title}" and all of its daily entries? This can't be undone.`)) return;
          const { error } = await supabase.from('devotionals').delete().eq('id', w.id);
          if (error) alert(/foreign key|violates/i.test(error.message)
            ? 'This week was not deleted because one of its days has saved answers. Saved answers are protected.'
            : `Could not delete: ${error.message}`);
          await loadWeeks();
        });
        return div;
      }

      async function loadWeeks() {
        const { data } = await supabase.from('devotionals').select('*').order('week_start', { ascending: false });
        weeks = data || [];
        weeksList.innerHTML = '';
        if (!weeks.length) {
          weeksList.innerHTML = '<p style="color:var(--ink-soft);">No devotional weeks yet. Add one above.</p>';
        } else {
          weeks.forEach(w => weeksList.appendChild(weekRow(w)));
        }
        populateWeekSelect();
      }

      // ---------------- Days ----------------
      const dayFormPanel = document.getElementById('day-form-panel');
      const daysList = document.getElementById('days-list');
      const daySelect = document.getElementById('day-week-select');

      function populateWeekSelect() {
        const prevValue = daySelect.value;
        if (!weeks.length) {
          daySelect.innerHTML = '<option value="">No weeks yet</option>';
          selectedWeekId = null;
        } else {
          daySelect.innerHTML = weeks.map(w => `<option value="${w.id}">${esc(w.week_start)} &mdash; ${esc(w.title)}</option>`).join('');
          selectedWeekId = weeks.some(w => w.id === prevValue) ? prevValue : weeks[0].id;
          daySelect.value = selectedWeekId;
        }
        loadDays();
      }

      daySelect.addEventListener('change', () => {
        selectedWeekId = daySelect.value || null;
        closeDayForm();
        loadDays();
      });

      function openDayForm(day) {
        if (!selectedWeekId) {
          alert('Add a devotional week first.');
          return;
        }
        document.getElementById('day-id').value = day?.id || '';
        document.getElementById('day-number').value = day?.day_number || (currentDays.length + 1);
        document.getElementById('day-title').value = day?.title || '';
        document.getElementById('day-scripture').value = day?.scripture_ref || '';
        document.getElementById('day-explanation').value = day?.simple_explanation || '';
        document.getElementById('day-application').value = day?.daily_application || '';
        document.getElementById('day-question').value = day?.daily_question || '';
        if (hasNewDayFields) {
          document.getElementById('day-support').value = day?.supporting_scripture_ref || '';
          document.getElementById('day-understanding').value = day?.understanding_text || '';
          document.getElementById('day-expanded').value = day?.expanded_reflection || '';
        }
        if (hasEveningFields) {
          document.getElementById('day-main').value = day?.main_reading_ref || '';
          document.getElementById('day-lookback').value = day?.looking_back_text || '';
          document.getElementById('day-prompts').value = day?.prayer_prompts || '';
        }
        dayFormPanel.style.display = 'flex';
        dayFormPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function closeDayForm() {
        dayFormPanel.style.display = 'none';
      }

      document.getElementById('new-day-btn').addEventListener('click', () => openDayForm(null));
      document.getElementById('cancel-day-btn').addEventListener('click', closeDayForm);

      document.getElementById('save-day-btn').addEventListener('click', async () => {
        if (!selectedWeekId) return;
        const id = document.getElementById('day-id').value;
        const payload = {
          devotional_id: selectedWeekId,
          day_number: parseInt(document.getElementById('day-number').value, 10),
          title: document.getElementById('day-title').value.trim(),
          scripture_ref: document.getElementById('day-scripture').value.trim() || null,
          simple_explanation: document.getElementById('day-explanation').value.trim(),
          daily_application: document.getElementById('day-application').value.trim(),
          daily_question: document.getElementById('day-question').value.trim() || null,
        };
        if (hasNewDayFields) {
          payload.supporting_scripture_ref = document.getElementById('day-support').value.trim() || null;
          payload.understanding_text = document.getElementById('day-understanding').value.trim() || null;
          payload.expanded_reflection = document.getElementById('day-expanded').value.trim() || null;
          // (the older closing_prayer column is intentionally never written from here; its saved text is kept as-is)
        }
        if (hasEveningFields) {
          payload.main_reading_ref = document.getElementById('day-main').value.trim() || null;
          payload.looking_back_text = document.getElementById('day-lookback').value.trim() || null;
          payload.prayer_prompts = document.getElementById('day-prompts').value.trim() || null;
        }
        if (!payload.day_number || !payload.title || !payload.simple_explanation || !payload.daily_application) {
          alert('Day number, title, simple explanation, and daily application are required.');
          return;
        }
        const saveRes = id
          ? await supabase.from('devotional_days').update(payload).eq('id', id)
          : await supabase.from('devotional_days').insert(payload);
        if (saveRes.error) { alert(`Could not save this day: ${saveRes.error.message}`); return; }
        closeDayForm();
        await loadDays();
      });

      function dayRow(d) {
        const div = document.createElement('div');
        div.className = 'card admin-row';
        div.innerHTML = `
          <div>
            <div class="eyebrow">Day ${esc(d.day_number)}</div>
            <h3 style="margin:0.25rem 0; font-size:1.05rem;">${esc(d.title)}</h3>
            ${d.scripture_ref ? `<p class="card-meta" style="margin:0;">${esc(parseScriptureRef(d.scripture_ref).reference)}</p>` : ''}
          </div>
          <div class="admin-row-actions">
            <button type="button" class="btn-small btn-secondary" data-action="edit">Edit</button>
            <button type="button" class="btn-small btn-danger" data-action="delete">Delete</button>
          </div>
        `;
        div.querySelector('[data-action="edit"]').addEventListener('click', () => openDayForm(d));
        div.querySelector('[data-action="delete"]').addEventListener('click', async () => {
          if (!confirm(`Delete day ${d.day_number} - "${d.title}"?`)) return;
          const { error } = await supabase.from('devotional_days').delete().eq('id', d.id);
          if (error) alert(/foreign key|violates/i.test(error.message)
            ? 'This day was not deleted because it has saved answers. Saved answers are protected.'
            : `Could not delete: ${error.message}`);
          await loadDays();
        });
        return div;
      }

      async function loadDays() {
        daysList.innerHTML = '';
        if (!selectedWeekId) {
          currentDays = [];
          daysList.innerHTML = '<p style="color:var(--ink-soft);">Add a devotional week first.</p>';
          return;
        }
        const { data } = await supabase
          .from('devotional_days')
          .select('*')
          .eq('devotional_id', selectedWeekId)
          .order('day_number', { ascending: true });
        currentDays = data || [];
        if (!currentDays.length) {
          daysList.innerHTML = '<p style="color:var(--ink-soft);">No daily entries for this week yet.</p>';
        } else {
          currentDays.forEach(d => daysList.appendChild(dayRow(d)));
        }
      }

      // ---------------- Accounts (administrator only; changes run through the secure server function) ----------------
      const myAcct = await getMyAccount();
      const accountsSection = document.getElementById('accounts-section');
      const accountsList = document.getElementById('accounts-list');
      const editPanel = document.getElementById('account-edit-panel');
      const resetPanel = document.getElementById('account-reset-panel');
      let accountsCache = [];
      const say = (id, msg, kind) => { const e = document.getElementById(id); e.className = 'inline-msg ' + (kind || ''); e.textContent = msg; };

      function accountCard(a) {
        const isMe = a.id === myAcct.user.id;
        const div = document.createElement('div');
        div.className = 'card admin-row';
        const when = a.last_sign_in_at ? new Date(a.last_sign_in_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : 'never';
        div.innerHTML = `
          <div>
            <h3 style="margin:0 0 0.25rem; font-size:1.05rem;">${esc(a.display_name || '(no name)')} ${isMe ? '<span class="badge">You &middot; Admin</span>' : ''}</h3>
            <p class="card-meta" style="margin:0;">Username: ${esc(a.username || '(not set)')}</p>
            <p class="card-meta" style="margin:0;">Email: ${esc(a.email || '')}${a.pending_email ? ' (pending change to ' + esc(a.pending_email) + ')' : ''}</p>
            <p class="card-meta" style="margin:0;">Status: ${a.must_change_password ? 'Must choose a new password at next sign-in' : 'Active'} &middot; last sign-in ${esc(when)}</p>
          </div>
          <div class="admin-row-actions">
            <button type="button" class="btn-small btn-secondary" data-action="edit">Edit user</button>
            ${isMe ? '' : '<button type="button" class="btn-small btn-secondary" data-action="reset">Reset password</button>'}
          </div>`;
        div.querySelector('[data-action="edit"]').addEventListener('click', () => openEdit(a));
        div.querySelector('[data-action="reset"]')?.addEventListener('click', () => openReset(a));
        return div;
      }
      async function loadAccounts() {
        const { data, error } = await invokeAdmin({ action: 'list_accounts' });
        accountsList.innerHTML = '';
        if (error) { accountsList.innerHTML = `<p class="card-meta">Account management is not available right now (${esc(error)}).</p>`; return; }
        accountsCache = data.accounts;
        accountsCache.forEach(a => accountsList.appendChild(accountCard(a)));
      }
      function openEdit(a) {
        resetPanel.style.display = 'none';
        document.getElementById('acct-edit-id').value = a.id;
        document.getElementById('account-edit-title').textContent = `Edit ${a.display_name || 'user'}`;
        document.getElementById('acct-name').value = a.display_name || '';
        document.getElementById('acct-username').value = a.username || '';
        document.getElementById('acct-email').value = a.email || '';
        document.getElementById('acct-email').dataset.original = a.email || '';
        document.getElementById('acct-email2').value = '';
        document.getElementById('acct-pw').value = '';
        syncEmailFields();
        say('acct-edit-msg', '');
        editPanel.style.display = 'flex';
        editPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function syncEmailFields() {
        const changed = document.getElementById('acct-email').value.trim() !== document.getElementById('acct-email').dataset.original;
        ['acct-email-confirm-row', 'acct-pw-row'].forEach(i => { document.getElementById(i).style.display = changed ? 'flex' : 'none'; });
        document.getElementById('acct-email-warning').style.display = changed ? 'block' : 'none';
      }
      document.getElementById('acct-email').addEventListener('input', syncEmailFields);
      document.getElementById('acct-cancel-btn').addEventListener('click', () => { editPanel.style.display = 'none'; });
      document.getElementById('acct-save-btn').addEventListener('click', async () => {
        const id = document.getElementById('acct-edit-id').value;
        const orig = accountsCache.find(x => x.id === id) || {};
        const fields = {};
        const name = document.getElementById('acct-name').value.trim();
        const uname = document.getElementById('acct-username').value.trim().toLowerCase();
        const email = document.getElementById('acct-email').value.trim();
        if (name !== (orig.display_name || '')) fields.display_name = name;
        if (uname !== (orig.username || '')) fields.username = uname === '' ? null : uname;
        if (email !== (orig.email || '')) fields.email = email;
        if (!Object.keys(fields).length) return say('acct-edit-msg', 'Nothing to change.', '');
        const body = { action: 'update_account', target_id: id, fields };
        if (fields.email) { body.confirm_email = document.getElementById('acct-email2').value.trim(); body.current_password = document.getElementById('acct-pw').value; }
        const { error } = await invokeAdmin(body);
        document.getElementById('acct-pw').value = '';
        if (error) return say('acct-edit-msg', error, 'error');
        say('acct-edit-msg', 'Saved.', 'ok');
        await loadAccounts();
      });
      function openReset(a) {
        editPanel.style.display = 'none';
        document.getElementById('acct-reset-id').value = a.id;
        document.getElementById('account-reset-title').textContent = `Reset password for ${a.display_name || 'user'}`;
        document.getElementById('acct-reset-pw').value = '';
        document.getElementById('acct-reset-temp').value = '';
        document.getElementById('acct-reset-result').style.display = 'none';
        document.getElementById('acct-temp-value').textContent = '';
        say('acct-reset-msg', '');
        resetPanel.style.display = 'flex';
        resetPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      function closeReset() {
        document.getElementById('acct-temp-value').textContent = '';   // never leave it on the page
        document.getElementById('acct-reset-result').style.display = 'none';
        document.getElementById('acct-reset-pw').value = ''; document.getElementById('acct-reset-temp').value = '';
        resetPanel.style.display = 'none';
      }
      document.getElementById('acct-reset-close').addEventListener('click', closeReset);
      document.getElementById('acct-reset-btn').addEventListener('click', async () => {
        const typed = document.getElementById('acct-reset-temp').value;
        const body = { action: 'reset_password', target_id: document.getElementById('acct-reset-id').value, current_password: document.getElementById('acct-reset-pw').value };
        if (typed) body.new_password = typed;
        const { data, error } = await invokeAdmin(body);
        document.getElementById('acct-reset-pw').value = '';
        if (error) return say('acct-reset-msg', error, 'error');
        document.getElementById('acct-reset-temp').value = '';
        say('acct-reset-msg', 'Done. They will be asked to choose their own password when they sign in.', 'ok');
        if (data.temporary_password) {
          document.getElementById('acct-temp-value').textContent = data.temporary_password;
          document.getElementById('acct-reset-result').style.display = 'block';
        }
        await loadAccounts();
      });
      if (myAcct?.role === 'admin') { accountsSection.style.display = 'block'; await loadAccounts(); }

      await loadAvatars();
      await loadWeeks();
    }
  </script>
</Layout>
